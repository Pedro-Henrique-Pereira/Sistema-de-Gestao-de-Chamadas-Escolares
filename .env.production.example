# Copie apenas as variaveis pertinentes para os arquivos externos do servidor.
# Nunca use estes valores ficticios em producao.

# /opt/lysimaco/env/backend.env
NODE_ENV=production
PORT=3000
BIND_HOST=0.0.0.0
TZ=America/Sao_Paulo
DB_HOST=mysql
DB_PORT=3306
DB_NAME=sistema_chamadas
DB_USER=sistema_chamadas_app
DB_PASSWORD=ALTERAR_NO_SERVIDOR
DB_TIMEZONE=-03:00
DB_CONNECTION_LIMIT=15
DB_QUEUE_LIMIT=0
ALLOWED_ORIGINS=https://lysimaco.com.br,https://www.lysimaco.com.br
FRONTEND_URL=https://lysimaco.com.br
PUBLIC_FRONTEND_URL=https://lysimaco.com.br
TRUST_PROXY=1
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
JWT_SECRET=GERAR_NO_SERVIDOR_COM_PELO_MENOS_32_CARACTERES
AUTH_DEV_BYPASS=false
DEV_LOGIN_ENABLED=false
AUDIT_RETENTION_DAYS=365
DISABLE_AUDIT_CLEANUP=false

# Adicione no backend.env as configuracoes SMTP e os tokens exclusivos das
# maquinas de automacao conforme backend/.env.exemple. Eles nao pertencem ao Git.

# /opt/lysimaco/env/mysql.env
MYSQL_DATABASE=sistema_chamadas
MYSQL_USER=sistema_chamadas_app
MYSQL_PASSWORD=ALTERAR_NO_SERVIDOR
MYSQL_ROOT_PASSWORD=GERAR_OUTRA_SENHA_FORTE_NO_SERVIDOR
