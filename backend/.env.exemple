PORT=3001
BIND_HOST=0.0.0.0

NODE_ENV=production

FRONTEND_URL=
# Origens adicionais exatas, separadas por virgula. Nao use curingas.
FRONTEND_URLS_EXTRAS=
# URL pública usada no link enviado por e-mail. Em produção, use HTTPS.
PUBLIC_FRONTEND_URL=https://sistema.exemplo.com

JWT_SECRET=troque-por-uma-chave-segura-com-pelo-menos-32-caracteres

# Recuperação de senha (token entre 15 e 30 minutos)
PASSWORD_RESET_TOKEN_TTL_MINUTES=20
PASSWORD_RESET_MIN_RESPONSE_MS=400
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_IP_RATE_LIMIT_MAX=20
PASSWORD_RESET_EMAIL_RATE_LIMIT_MAX=5
PASSWORD_RESET_TOKEN_VALIDATE_RATE_LIMIT_MAX=20
PASSWORD_RESET_TOKEN_RATE_LIMIT_MAX=10

# SMTP. Nunca salve credenciais reais neste arquivo de exemplo.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=usuario-smtp
SMTP_PASS=senha-smtp
SMTP_FROM_EMAIL=nao-responda@exemplo.com
SMTP_FROM_NAME=Sistema Lysimaco Digital
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Fuso horário oficial do sistema escolar
TZ=America/Sao_Paulo
DB_TIMEZONE=-03:00

# Auditoria: retenção de 365 dias por padrão (faixa segura: 30 a 3650 dias).
AUDIT_RETENTION_DAYS=365
# Use apenas em testes; em produção a rotina persistente deve permanecer ativa.
DISABLE_AUDIT_CLEANUP=false

# Integração independente com o aplicativo de automação.
# Repita o mesmo token nas máquinas que um único app poderá selecionar pela interface.
# Use tokens diferentes quando cada instalação precisar ficar restrita a uma só máquina.
# Exemplo flexível: {"1":"token-seguro-compartilhado-com-32-caracteres","2":"token-seguro-compartilhado-com-32-caracteres"}
AUTOMATION_SERVICE_TOKENS={}
AUTOMATION_DELIVERY_MAX_ATTEMPTS=3
AUTOMATION_DELIVERY_LEASE_SECONDS=300
AUTOMATION_DELIVERY_BATCH_SIZE=25
AUTOMATION_DEFAULT_COUNTRY_CODE=55
