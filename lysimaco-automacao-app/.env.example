# URL pública do backend. Use HTTPS quando o sistema estiver em outro computador/servidor.
API_BASE_URL=https://api.exemplo.com
# Token autorizado para as máquinas que poderão ser selecionadas na interface.
# No backend, repita este valor nas respectivas chaves de AUTOMATION_SERVICE_TOKENS.
# Nunca versione o token real.
AUTOMATION_API_TOKEN=
AUTOMATION_WORKER_ID=automacao-escola
# Valor inicial; depois pode ser alterado e salvo diretamente na interface.
NUMERO_MAQUINA=1
API_TIMEOUT_SECONDS=20
API_RETRY_DELAY_SECONDS=15
POLL_INTERVAL_SECONDS=20

BROWSER=chrome
HEADLESS=false
USER_DATA_DIR=./runtime/whatsapp-profile
WAIT_LOGIN_SECONDS=180
PAGE_LOAD_TIMEOUT_SECONDS=20
CONVERSATION_WAIT_SECONDS=35
AFTER_SEND_WAIT_SECONDS=1.5
SEND_MIN_DELAY_SECONDS=5
SEND_MAX_DELAY_SECONDS=12
DRY_RUN=false

# Somente para desenvolvimento em uma rede local controlada.
ALLOW_INSECURE_HTTP=false
